# Names only. Copy to .env and fill in. Never commit .env.

# Django
SECRET_KEY=
DEBUG=
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
SECURE_COOKIES=
DATABASE_URL=
MEDIA_ROOT=
STATIC_ROOT=
MAX_UPLOAD_BYTES=
MAX_FILES_PER_BATCH=
LOGIN_RATE=

# Postgres container (docker compose)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# LLM (Gemini primary, Groq fallback)
LLM_PROVIDER=  # gemini | groq | offline (offline = rule-based stand-in, no key needed)
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=

# Seed data
SEED_PASSWORD=

# Caddy
SITE_ADDRESS=

# Local dev only (Vite proxy target)
VITE_PROXY_TARGET=
# true shows quick-fill demo accounts on the login page (synthetic data only)
VITE_DEMO_MODE=

# Worker (batch = CVs processed per tick; backoff doubles per failed attempt)
WORKER_BATCH_SIZE=
WORKER_POLL_SECONDS=
WORKER_BACKOFF_SECONDS=
